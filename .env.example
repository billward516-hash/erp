# Owner/migration connection (creates roles, runs DDL). Never used by the app at runtime.
DATABASE_ADMIN_URL=postgres://erp_owner:erp_owner_dev@localhost:54329/erp
# Runtime connection: non-owner role, subject to row-level security.
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:54329/erp
STORAGE_DIR=./.storage
PORT=3000
# dev-token auth is for local development only; see docs/DECISIONS.md D-008
AUTH_MODE=dev-token
# Outgoing email (D-183B). Unset SMTP_HOST = email is written to files under STORAGE_DIR/mail and not delivered.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=starttls   # starttls (default) | true (TLS from the start, port 465) | false (no encryption, trusted local relay only)
# MAIL_FROM="Ops Platform <notifications@your-domain.example>"
